# MLBB Tracker backend configuration.
# Copy to `.env` and adjust. Never commit the real `.env` file.

MLBB_ENVIRONMENT=development
MLBB_LOG_LEVEL=INFO

# Provider endpoints (public, no API key required).
MLBB_RONE_BASE_URL=https://arena.rone.dev/api
MLBB_MLBBDEX_BASE_URL=https://mlbbdex.com/api/v1

# Provider toggles.
MLBB_ENABLE_RONE=true
MLBB_ENABLE_MLBBDEX=true

# Player lookup stays off: no permitted public source exposes player stats.
MLBB_ENABLE_PLAYER_LOOKUP=false

# CORS. Use a JSON array; restrict in production.
MLBB_CORS_ORIGINS=["*"]

# Cache TTLs in seconds.
MLBB_CACHE_TTL_CATALOG=21600
MLBB_CACHE_TTL_RANKINGS=3600
MLBB_CACHE_TTL_DETAIL=21600

# If a future provider needs credentials, keep them here (server-side only).
# MLBB_PLAYER_API_KEY=
